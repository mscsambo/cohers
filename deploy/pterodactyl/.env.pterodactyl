APP_NAME=COHERS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://my.anajak.cloud:24063
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/home/container/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------- COHERS ----------------
COHERS_REFERENCE_PREFIX=COH
COHERS_DISPLAY_TIMEZONE=Asia/Phnom_Penh
COHERS_REQUIRE_MFA=true
COHERS_INCENTIVES_ENABLED=false
COHERS_AI_DRIVER=keyword

# Set these here or later in Admin > Configuration (restart the server after changing the bot token).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=cohers_bot
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
